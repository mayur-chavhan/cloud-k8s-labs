# Copy to .env and paste values from the Pluralsight sandbox details panel.

# --- from the new sandbox (changes EVERY sandbox) ---
AZ_SUBSCRIPTION_ID=<paste>
AZ_RG_NAME=<paste 1-xxxxxxxx-playground-sandbox>
AZ_SP_CLIENT_ID=<paste Application Client ID>
AZ_SP_SECRET=<paste Secret>              # stay in .env only — never commit
# --- usually constant ---
AZ_TENANT=realhandsonlabs.com
AZ_LOCATION=eastus

# --- your choice, stable across sessions ---
AZ_CLUSTER_NAME=aks-lab01
AZ_NODE_COUNT=1
AZ_NODE_SIZE=Standard_B2s
