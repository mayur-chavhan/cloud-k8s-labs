# Copy to .env; fill region + names. AWS sandbox credentials are pasted in 01-setup.sh,
# NOT here — they live in ~/.aws/credentials of the machine you run from.

AWS_DEFAULT_REGION=us-east-1
EKS_CLUSTER_NAME=eks-lab01
EKS_NODE_SIZE=t3.medium       # cheapest sane EKS node; shrink to t3.small if quota complains
EKS_NODE_COUNT=1
